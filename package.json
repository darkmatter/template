{
  "name": "effect-agent-harness-demo",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@effect/platform-bun": "4.0.0-beta.102",
      "@effect/platform-node": "4.0.0-beta.102",
      "@effect/vitest": "4.0.0-beta.102",
      "@tauri-apps/cli": "^2.10.0",
      "@types/bun": "^1.3.10",
      "@types/node": "^24.0.0",
      "alchemy": "2.0.0-beta.70",
      "alchemy-sops": "0.8.1",
      "effect": "4.0.0-beta.102",
      "typescript": "^7.0.2",
      "vite": "^8.2.2",
      "vitest": "^4.1.6"
    }
  },
  "type": "module",
  "scripts": {
    "cli": "bun apps/cli/src/main.ts",
    "dev": "bun run --cwd apps/web dev",
    "harnessd": "bun apps/harnessd/src/server.ts",
    "check": "bun run lint:boundaries && turbo boundaries && tsc && bun run --filter '*' typecheck",
    "lint:boundaries": "depcruise apps packages tests",
    "check:rust": "cargo check --workspace",
    "generate:bun-nix": "bun2nix -o bun.nix",
    "test": "vitest run",
    "test:rust": "cargo test --workspace",
    "test:watch": "vitest",
    "web": "bun apps/web/src/server.ts",
    "lint": "oxlint apps packages tests oxlint.config.ts vitest.config.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepare": "effect-tsgo patch --no-typescript --oxlint"
  },
  "devDependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "0.43.0",
    "@repo/tooling": "workspace:*",
    "@swc/core": "^1.16.2",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "alchemy": "catalog:",
    "bun2nix": "^2.1.2",
    "dependency-cruiser": "18.2.0",
    "effect": "catalog:",
    "oxfmt": "^0.62.0",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "turbo": "^2.10.12",
    "typescript": "7.0.2",
    "vitest": "catalog:"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-beta.102",
    "@effect/sql-d1": "4.0.0-beta.102",
    "@effect/sql-sqlite-do": "4.0.0-beta.102"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.3.14"
}
