{
  "name": "ops-monorepo-demo",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@effect/platform-bun": "4.0.0-beta.102",
      "@effect/vitest": "4.0.0-beta.102",
      "@types/bun": "^1.3.10",
      "@types/node": "^24.0.0",
      "effect": "4.0.0-beta.102",
      "typescript": "^7.0.2",
      "vitest": "^4.1.6",
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "lucide-react": "^1.7.0",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.5",
      "@libsql/client": "0.17.2",
      "libsql": "0.5.22",
      "@orpc/server": "^1.12.2",
      "@orpc/client": "^1.12.2",
      "@orpc/openapi": "^1.12.2",
      "@orpc/zod": "^1.12.2",
      "@orpc/tanstack-query": "^1.13.6",
      "better-auth": "1.5.5",
      "@tanstack/react-form": "^1.28.0",
      "@polar-sh/better-auth": "^1.8.3",
      "@types/react-dom": "^19.2.3",
      "alchemy": "2.0.0-beta.66",
      "@better-auth/expo": "1.5.5",
      "drizzle-orm": "^0.45.1",
      "@effect/platform-node": "4.0.0-beta.102"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "check": "tsc && bun run --filter '@ops-demo/web' typecheck && bun run --filter '@repo/web-core' typecheck",
    "generate:bun-nix": "bun2nix -o bun.nix",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepare": "effect-tsgo patch --no-typescript --oxlint"
  },
  "devDependencies": {
    "@effect/tsgo": "0.36.1",
    "@repo/tooling": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "bun2nix": "^2.1.2",
    "oxfmt": "^0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "7.0.2",
    "vitest": "catalog:",
    "@cloudflare/workers-types": "^4.20251213.0",
    "turbo": "^2.8.12",
    "alchemy": "catalog:",
    "effect": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-beta.102"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.3.14"
}
