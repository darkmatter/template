{
  "extends": "@repo/tooling/tsconfig",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "paths": {
      "#*": ["./src/*"]
    }
  },
  "include": [
    "alchemy.run.ts",
    "waku.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": ["node_modules", "dist", ".alchemy"]
}
